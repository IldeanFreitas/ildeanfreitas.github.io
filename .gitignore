# ---- Segredos e credenciais: NUNCA versionar ----
.env
.env.*
*.pem
*.key
*.pfx
credentials*
secrets*
config.local.*

# ---- Artefatos Power BI / Power Platform com dados ----
*.pbix
*.pbip
*.pbit
*.rdl
*.msapp
*.zip

# ---- Planilhas e extrações que podem conter dado corporativo ----
*.xlsx
*.xls
*.csv
*.bak

# ---- Sistema e editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---- Node / build (caso um dia haja pipeline) ----
node_modules/
dist/
.cache/

# ---- Ferramentas de qualidade (etapa 0 da refatoração) ----
npm-debug.log*
*.log

# Saída do Playwright. As capturas de referência em
# tests/*-snapshots/ SÃO versionadas: sem elas a etapa 2 não teria
# contra o que comparar.
test-results/
playwright-report/
blob-report/

# Capturas de referencia visual: 21 MB por conjunto, e o Git guardaria cada
# versao para sempre. Sao artefato local e transitorio -- gere com
# `npm run baseline` antes de comecar uma etapa, compare com
# `npm run test:visual` ao termina-la. Ver docs/QUALIDADE.md.
tests/*-snapshots/
