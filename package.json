{
  "name": "ildeanfreitas-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfólio profissional — Power Platform, Engenharia de Dados e IA Aplicada.",
  "homepage": "https://ildeanfreitas.github.io/",
  "author": "Ildean Freitas",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:css": "stylelint \"**/*.{css,html}\"",
    "lint:js": "eslint .",
    "lint:html": "html-validate index.html en/index.html 404.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs && node scripts/sitemap.mjs",
    "build:check": "node scripts/build.mjs --check",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "test": "npm run test:unit && playwright test tests/comportamento.spec.js tests/acessibilidade.spec.js tests/sem-javascript.spec.js tests/movimento-reduzido.spec.js",
    "test:unit": "node --test tests/unidade/cases.unit.mjs",
    "test:visual": "playwright test tests/visual.spec.js",
    "test:ui": "playwright test --ui",
    "baseline": "playwright test tests/visual.spec.js --update-snapshots",
    "check": "npm run build:check && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.12.0",
    "html-validate": "^8.24.0",
    "postcss-html": "^1.7.0",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
